# Match the 4 MB flash on a standard ESP32 devkit (the ESP-IDF default is 2 MB,
# which makes PlatformIO warn about a size mismatch).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Full printf formatting so that %f in the log output works.
CONFIG_NEWLIB_NANO_FORMAT=n

# Keep the log console on UART0 at the rate platformio.ini monitors.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# app_main brings WiFi up, and esp_wifi_start() with PHY calibration is
# stack-hungry. The 3584-byte default leaves little headroom.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=5120

# OTA rollback: a freshly flashed image boots "on trial" and must call
# esp_ota_mark_app_valid_cancel_rollback() (main.c does, once the console is up)
# or the bootloader reverts to the previous slot on the next reset. Turns a bad
# OTA into an automatic recovery instead of a device that has to be re-flashed
# over USB.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
